    "\n",
    "# Since I have the us_regression_data populated already above, we will proceed with generating the OLS result\n",
    "# for just one of the assets using all factor models and print a summary for all Using all factor models.\n",
    "Y_nvda = us_regression_data['NVDA_Excess']\n",
    "X_factors = us_regression_data[['Mkt-RF', 'SMB', 'HML', 'Mom', 'RMW', 'CMA']]\n",
    "X_const = sm.add_constant(X_factors)\n",
    "\n",
    "# 1. Fama-French 3-Factor Model (FF3)\n",
    "factors_ff3 = ['Mkt-RF', 'SMB', 'HML']\n",
    "X_ff3 = X_const[factors_ff3 + ['const']]\n",
    "model_ff3 = sm.OLS(Y_nvda, X_ff3).fit()\n",
    "\n",
    "# 2. Carhart 4-Factor Model (C4)\n",
    "factors_c4 = ['Mkt-RF', 'SMB', 'HML', 'Mom']\n",
    "X_c4 = X_const[factors_c4 + ['const']]\n",
    "model_c4 = sm.OLS(Y_nvda, X_c4).fit()\n",
    "\n",
    "# 3. Fama-French 5-Factor Model (FF5)\n",
    "factors_ff5 = ['Mkt-RF', 'SMB', 'HML', 'RMW', 'CMA']\n",
    "X_ff5 = X_const[factors_ff5 + ['const']]\n",
    "model_ff5 = sm.OLS(Y_nvda, X_ff5).fit()\n",
    "\n",
    "\n",
    "print(\"--- 🔬 Full OLS Regression Results for NVDA ---\")\n",
    "print(\"\\n### Fama-French 3-Factor Model Summary\")\n",
    "print(model_ff3.summary())\n",
    "print(\"\\n### Carhart 4-Factor Model Summary\")\n",
    "print(model_c4.summary())\n",
    "print(\"\\n### Fama-French 5-Factor Model Summary\")\n",
    "print(model_ff5.summary())"
   ]
