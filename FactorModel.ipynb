    "import pandas_datareader.data as web\n",
    "import pandas as pd\n",
    "import statsmodels.api as sm\n",
    "import yfinance as yf\n",
    "\n",
    "# --- 1. UK Stock Data (Re-run for continuity) ---\n",
    "uk_tickers = ['OCDO.L', 'LLOY.L', 'ULVR.L', 'AAL.L']\n",
    "start_date = '2014-01-01'\n",
    "end_date = '2025-01-01' \n",
    "\n",
    "daily_data_uk = yf.download(uk_tickers, start=start_date, end=end_date)['Close']\n",
    "uk_monthly_returns = daily_data_uk.resample('M').last().ffill().pct_change().dropna()\n",
    "uk_monthly_returns.index = uk_monthly_returns.index.tz_localize(None).normalize()\n",
    "stock_columns_uk = uk_monthly_returns.columns.tolist()\n",
    "\n",
    "\n",
    "# --- 2. UK Factor Data Sourcing (Developed Europe Proxy) ---\n",
    "print(\"\\nFetching Developed Europe Fama-French 5 Factors (Proxy for UK)...\")\n",
    "\n",
    "try:\n",
    "    # Fama-French 5 Factors + RF\n",
    "    ff_europe_data = web.DataReader('Europe_5_Factors', 'famafrench', start=start_date, end=end_date)[0] \n",
    "    \n",
    "    # Momentum factor (Will likely have column name 'WML')\n",
    "    mom_europe_data = web.DataReader('Europe_Mom_Factor', 'famafrench', start=start_date, end=end_date)[0]\n",
    "\n",
    "    # *** FIX ***: Rename the Momentum column from 'WML' to 'Mom'\n",
    "    # Use .columns[0] as the momentum data only has one column.\n",
    "    if mom_europe_data.columns[0] != 'Mom':\n",
    "        mom_europe_data.rename(columns={mom_europe_data.columns[0]: 'Mom'}, inplace=True)\n",
    "    \n",
    "    # Merge FF5 and Momentum\n",
    "    uk_ff_factors = ff_europe_data.merge(mom_europe_data, left_index=True, right_index=True)\n",
    "    uk_ff_factors = uk_ff_factors / 100.0 # Convert from percent to decimal\n",
    "    \n",
    "    # Align Index\n",
    "    uk_ff_factors.index = uk_ff_factors.index.to_timestamp('M', how='end').tz_localize(None).normalize()\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"🚨 CRITICAL ERROR: Could not fetch Developed Europe Fama-French data. Details: {e}\")\n",
    "    # Re-raising the error if it's not the column name issue\n",
    "    raise\n",
    "    \n",
    "# --- 3. Merge and Calculate UK Excess Returns ---\n",
    "merged_data_uk = uk_monthly_returns.merge(uk_ff_factors, left_index=True, right_index=True, how='inner')\n",
    "\n",
    "if merged_data_uk.empty:\n",
    "    print(\"\\n🚨 CRITICAL ERROR: UK Merge failed. DataFrames are empty after merge.\")\n",
    "else:\n",
    "    uk_excess_returns = pd.DataFrame(index=merged_data_uk.index)\n",
    "    for ticker in stock_columns_uk:\n",
    "        uk_excess_returns[f'{ticker}_Excess'] = merged_data_uk[ticker] - merged_data_uk['RF']\n",
    "\n",
    "    # Final UK Regression DataFrame\n",
    "    uk_regression_data = pd.concat([uk_excess_returns, merged_data_uk[['Mkt-RF', 'SMB', 'HML', 'Mom', 'RMW', 'CMA']]], axis=1)\n",
    "\n",
    "    print(\"\\n✅ UK Data Preparation Complete. Data Head:\")\n",
    "    print(\"-----------------------------------------------------\")\n",
    "    print(uk_regression_data.head())\n",
    "    \n",
    "    # --- 4. Run UK Regression Analysis ---\n",
    "    \n",
    "    results_uk = {}\n",
    "    factors_map = {\n",
    "        'FF3': ['Mkt-RF', 'SMB', 'HML'],\n",
    "        'Carhart4': ['Mkt-RF', 'SMB', 'HML', 'Mom'],\n",
    "        'FF5': ['Mkt-RF', 'SMB', 'HML', 'RMW', 'CMA']\n",
    "    }\n",
    "\n",
    "    X_factors_uk = uk_regression_data[['Mkt-RF', 'SMB', 'HML', 'Mom', 'RMW', 'CMA']]\n",
    "    X_const_uk = sm.add_constant(X_factors_uk) \n",
    "\n",
    "    print(\"\\n--- 📈 Running UK Market Factor Regressions... ---\")\n",
    "\n",
    "    for ticker in [t.replace('.L', '') for t in stock_columns_uk]:\n",
    "        # Ticker column name includes .L_Excess, but regression result key should be clean\n",
    "        Y = uk_regression_data[f'{ticker}.L_Excess']\n",
    "        results_uk[ticker] = {}\n",
    "        \n",
    "        for model_name, factors in factors_map.items():\n",
    "            X = X_const_uk[factors + ['const']]\n",
    "            model = sm.OLS(Y, X).fit()\n",
    "            \n",
    "            results_uk[ticker][model_name] = {\n",
    "                'Alpha': model.params['const'],\n",
    "                'Alpha_PValue': model.pvalues['const'],\n",
    "                'R_Squared': model.rsquared,\n",
    "                'Adj_R_Squared': model.rsquared_adj\n",
    "            }\n",
    "\n",
    "    print(\"\\n--- 📊 UK Market Regression Summary Table ---\")\n",
    "    \n",
    "    summary_data_uk = []\n",
    "    for ticker, models in results_uk.items():\n",
    "        for model_name, metrics in models.items():\n",
    "            summary_data_uk.append([\n",
    "                ticker,\n",
    "                model_name,\n",
    "                f\"{metrics['Alpha']:.6f}\",\n",
    "                f\"{metrics['Alpha_PValue']:.4f}\",\n",
    "                f\"{metrics['R_Squared']:.4f}\",\n",
    "                f\"{metrics['Adj_R_Squared']:.4f}\"\n",
    "            ])\n",
    "\n",
    "    uk_summary_df = pd.DataFrame(summary_data_uk, columns=['Asset', 'Model', 'Alpha', 'Alpha P-Value', '$R^2$', 'Adj. $R^2$'])\n",
    "    print(uk_summary_df.to_markdown(index=False))"
   ]
  },
