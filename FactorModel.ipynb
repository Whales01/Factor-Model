    "# --- Assuming you ran the regressions and saved the results earlier ---\n",
    "\n",
    "# Combined the existing DataFrames:\n",
    "combined_df = pd.concat([us_summary_df, uk_summary_df], ignore_index=True)\n",
    "\n",
    "# Plot using the existing DataFrame:\n",
    "plt.figure(figsize=(14, 7))\n",
    "sns.barplot(data=combined_df, x='Asset', y='Adj. $R^2$', hue='Model', palette='viridis', dodge=True)\n",
    "\n",
    "\n",
    "# Add separator lines between markets\n",
    "asset_names = combined_df['Asset'].unique()\n",
    "us_assets = us_summary_df['Asset'].unique()\n",
    "uk_assets = uk_summary_df['Asset'].unique()\n",
    "us_end_index = len(us_assets) - 0.5\n",
    "\n",
    "# Add title, labels, and legend\n",
    "plt.title('Comparison of Adjusted $R^2$ Across Factor Models: US vs. UK Market', fontsize=16)\n",
    "plt.ylabel('Adjusted $R^2$ (Explanatory Power)', fontsize=12)\n",
    "plt.xlabel('Asset (Grouped by Market)', fontsize=12)\n",
    "plt.axvline(x=us_end_index, color='red', linestyle='--', linewidth=1.5, label='Market Split (US | UK)')\n",
    "plt.legend(title='Model', bbox_to_anchor=(1.01, 1), loc='upper left')\n",
    "\n",
    "# Add Market Labels\n",
    "plt.text(us_end_index / 2, combined_df['Adj. $R^2$'].max() + 0.02, 'US Market', \n",
    "         horizontalalignment='center', color='black', fontsize=12, fontweight='bold')\n",
    "plt.text(us_end_index + len(uk_assets) / 2, combined_df['Adj. $R^2$'].max() + 0.02, 'UK Market', \n",
    "         horizontalalignment='center', color='black', fontsize=12, fontweight='bold')\n",
    "\n",
    "plt.ylim(0, combined_df['Adj. $R^2$'].max() * 1.1)\n",
    "plt.tight_layout(rect=[0, 0, 1, 0.95]) # Adjust layout to make space for the main title and market labels\n",
    "\n",
    "\n",
    "plt.show()"
