    "# --------------------------------------------\n",
    "# 1. Define inputs and compute the returns \n",
    "# --------------------------------------------\n",
    "us_tickers = ['TSLA', 'XOM', 'JNJ', 'NVDA']\n",
    "start_date = '2014-01-01'\n",
    "end_date = '2025-01-01' # yfinance will fetch up to the last available day before this date\n",
    "\n",
    "# 2. Fetch daily data\n",
    "print(f\"Fetching daily data for US stocks: {us_tickers}...\")\n",
    "try:\n",
    "    # Use 'Adj Close' for accurate historical returns\n",
    "    daily_data = yf.download(us_tickers, start=start_date, end=end_date)['Close']\n",
    "    \n",
    "    # 3. Resample and Calculate Monthly Returns\n",
    "    # .resample('M') groups data by month end.\n",
    "    # .ffill() handles potential missing values by forward-filling them (important for accurate calculation).\n",
    "    # .pct_change() calculates the percentage change between the current month-end price and the previous month-end price.\n",
    "    monthly_prices = daily_data.resample('M').last().ffill()\n",
    "    \n",
    "    # Calculate monthly returns (R_i)\n",
    "    us_monthly_returns = monthly_prices.pct_change().dropna()\n",
    "    \n",
    "    print(\"\\n✅ US Monthly Stock Returns Calculated Successfully.\")\n",
    "    print(\"-----------------------------------------------------\")\n",
    "    print(\"Sample of Monthly Returns (R_i):\")\n",
    "    print(us_monthly_returns.head())\n",
    "    \n",
    "    # Rename columns for clarity (optional, but good practice)\n",
    "    us_monthly_returns.columns = [f'{ticker}_Return' for ticker in us_monthly_returns.columns]\n",
    "    \n",
    "except Exception as e:\n",
    "    print(f\"An error occurred during data fetching or processing: {e}\")\n",
    "    us_monthly_returns = pd.DataFrame() # Create an empty DataFrame on failure\n",
    "# Saving the resulting DataFrame to avoid blockage from too much calls for the next step\n",
    "# us_monthly_returns now contains R_i (monthly return for each stock)\n",
    "output_file_name_usdata = 'US_Stock_Data_4_Factor_Model.csv'\n",
    "daily_data.to_csv(output_file_name_usdata)\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# Getting the Factor model library \n",
    "# ----------------------------------------------------------\n",
    "# Fetch the list of all available Fama-French datasets\n",
    "print(\"Fetching the list of all available Fama-French data keys...\")\n",
    "pandas_datareader.famafrench.get_available_datasets()\n",
    "try:\n",
    "    all_ff_datasets = web.get_available_datasets()\n",
    "\n",
    "    print(\"\\n✅ Successfully retrieved the list of Fama-French data keys.\")\n",
    "    print(\"-----------------------------------------------------\")\n",
    "    print(f\"Total number of available datasets: {len(all_ff_datasets)}\")\n",
    "    print(\"\\nSample of the first 20 dataset keys:\")\n",
    "    \n",
    "    # Print the first 20 keys for a quick look\n",
    "    for i, dataset_key in enumerate(all_ff_datasets[:20]):\n",
    "        print(f\"{i+1}. {dataset_key}\")\n",
    "        \n",
    "    print(\"\\n...\")\n",
    "    print(\"-----------------------------------------------------\")\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"An error occurred while fetching the dataset list: {e}\")\n",
    "    all_ff_datasets = []\n",
    "# Assuming 'us_monthly_returns' DataFrame from the previous step is available\n",
    "# Re-define dates to ensure consistency\n",
    "start_date_ff = '2014-01-01'\n",
    "end_date_ff = '2025-01-01' \n",
    "\n",
    "\n",
    "# 1. Fetch US Stock Returns\n",
    "us_tickers = ['TSLA', 'XOM', 'JNJ', 'NVDA']\n",
    "start_date = '2014-01-01'\n",
    "end_date = '2025-01-01' \n",
    "daily_data = yf.download(us_tickers, start=start_date, end=end_date)['Close']\n",
    "us_monthly_returns = daily_data.resample('M').last().ffill().pct_change().dropna()\n",
    "stock_columns = us_monthly_returns.columns.tolist()\n",
    "\n",
    "# **Crucial step for yfinance data:** Ensure index is a standard end-of-month Timestamp\n",
    "# The default yfinance end-of-month date can sometimes be 00:00:00. We ensure it's time-zone naive.\n",
    "us_monthly_returns.index = us_monthly_returns.index.tz_localize(None).normalize()\n",
    "\n",
    "# 2. Fetch Fama-French Factors (FF5 + Momentum)\n",
    "ff5_data = web.DataReader('F-F_Research_Data_5_Factors_2x3', 'famafrench', start=start_date, end=end_date)[0] \n",
    "mom_data = web.DataReader('F-F_Momentum_Factor', 'famafrench', start=start_date, end=end_date)[0] \n",
    "ff_factors = ff5_data.merge(mom_data, left_index=True, right_index=True)\n",
    "ff_factors = ff_factors / 100.0 # Convert from percent to decimal\n",
    "\n",
    "# *** FIX: Robust Index Alignment for Fama-French ***\n",
    "# Convert the Fama-French PeriodIndex (e.g., '2014-01') directly to an end-of-month Timestamp (normalized).\n",
    "ff_factors.index = ff_factors.index.to_timestamp('M', how='end').tz_localize(None).normalize()\n",
    "\n",
    "# 3. Merge DataFrames\n",
    "# Now both indices are guaranteed to be simple datetime.date objects for the merge.\n",
    "merged_data = us_monthly_returns.merge(ff_factors, left_index=True, right_index=True, how='inner')\n",
    "\n",
    "# Check if merge was successful\n",
    "if merged_data.empty:\n",
    "    print(\"\\n🚨 CRITICAL ERROR: Merge failed. DataFrames are empty after merge. Cannot proceed.\")\n",
    "    # You might need to manually check index formats if this fails again.\n",
    "else:\n",
    "    # 4. Calculate US Excess Returns (R_i - R_f)\n",
    "    us_excess_returns = pd.DataFrame(index=merged_data.index)\n",
    "    for ticker in stock_columns:\n",
    "        us_excess_returns[f'{ticker}_Excess'] = merged_data[ticker] - merged_data['RF']\n",
    "\n",
    "    # Final DataFrame for Regression\n",
    "    us_regression_data = pd.concat([us_excess_returns, merged_data[['Mkt-RF', 'SMB', 'HML', 'Mom', 'RMW', 'CMA']]], axis=1)\n",
    "\n",
    "    print(\"\\n✅ US Data Preparation Complete. Data Head:\")\n",
    "    print(\"-----------------------------------------------------\")\n",
    "    print(us_regression_data.head())\n",
    "\n",
    "# ---------------------------------------------------\n",
    "# Regression Analysis\n",
    "# ---------------------------------------------------\n",
    "results_us = {}\n",
    "\n",
    "# Factors for each model\n",
    "factors_map = {\n",
    "    'FF3': ['Mkt-RF', 'SMB', 'HML'],\n",
    "    'Carhart4': ['Mkt-RF', 'SMB', 'HML', 'Mom'],\n",
    "    'FF5': ['Mkt-RF', 'SMB', 'HML', 'RMW', 'CMA']\n",
    "}\n",
    "\n",
    "# The list of stock tickers to loop through\n",
    "stock_columns = ['JNJ', 'NVDA', 'TSLA', 'XOM'] \n",
    "\n",
    "# Add a constant (intercept, Alpha) to the independent variables\n",
    "X_factors = us_regression_data[['Mkt-RF', 'SMB', 'HML', 'Mom', 'RMW', 'CMA']]\n",
    "X_const = sm.add_constant(X_factors) \n",
    "\n",
    "print(\"\\n--- 📈 Running US Market Factor Regressions... ---\")\n",
    "\n",
    "for ticker in stock_columns:\n",
    "    Y = us_regression_data[f'{ticker}_Excess']\n",
    "    results_us[ticker] = {}\n",
    "    \n",
    "    for model_name, factors in factors_map.items():\n",
    "        X = X_const[factors + ['const']]\n",
    "        \n",
    "        # Check if the required factors exist in the data (they should, but good practice)\n",
    "        if all(f in X.columns for f in factors + ['const']):\n",
    "            model = sm.OLS(Y, X).fit()\n",
    "            \n",
    "            # Store key academic metrics: Alpha (const), R-squared, Adj. R-squared\n",
    "            results_us[ticker][model_name] = {\n",
    "                'Alpha': model.params['const'],\n",
    "                'Alpha_PValue': model.pvalues['const'],\n",
    "                'R_Squared': model.rsquared,\n",
    "                'Adj_R_Squared': model.rsquared_adj\n",
    "            }\n",
    "        else:\n",
    "             print(f\"Warning: Missing factors for {model_name} on {ticker}. Skipping.\")\n",
    "\n",
    "\n",
    "print(\"\\n--- 📊 US Market Regression Summary: Alpha, P-Value, and R-Squared ---\")\n",
    "\n",
    "summary_data = []\n",
    "for ticker, models in results_us.items():\n",
    "    for model_name, metrics in models.items():\n",
    "        summary_data.append([\n",
    "            ticker,\n",
    "            model_name,\n",
    "            f\"{metrics['Alpha']:.6f}\",\n",
    "            f\"{metrics['Alpha_PValue']:.4f}\",\n",
    "            f\"{metrics['R_Squared']:.4f}\",\n",
    "            f\"{metrics['Adj_R_Squared']:.4f}\"\n",
    "        ])\n",
    "\n",
    "summary_df = pd.DataFrame(summary_data, columns=['Asset', 'Model', 'Alpha', 'Alpha P-Value', '$R^2$', 'Adj. $R^2$'])\n",
    "print(summary_df.to_markdown(index=False)) "
   ]
  },
